IMAGE_NAME="Alpine-NTFS"
DISK_SIZE_MB=4048
BOOT_SIZE_MB=512
KERNEL_VERSION="$(uname -r)"

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOTFS_DIR="$BASE_DIR/rootfs"
PATCHES_DIR="$BASE_DIR/patches"
NTRAMFS_DIR="$BASE_DIR/ntramfs"
BUILD_DIR="$BASE_DIR/build"
CHROOT_PACKAGES="ntfs-3g util-linux busybox-static"

PATCHED_ROOTFS="$BUILD_DIR/rootfs_patched"
INITRAMFS_WORK="$BUILD_DIR/initramfs_work"
ISO_WORK="$BUILD_DIR/iso_root"

OUTPUT_QCOW2="$BUILD_DIR/${IMAGE_NAME}.qcow2"
OUTPUT_ISO="$BUILD_DIR/${IMAGE_NAME}-installer.iso"